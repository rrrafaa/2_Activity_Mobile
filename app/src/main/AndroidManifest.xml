<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PAM5"
        tools:targetApi="31">

        <!-- Tugas 4 : MainActivity (activity utama / launcher) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Tugas 4 - Counter">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tugas 2 : 2 Activity (Activity 1 -> Activity 2) -->
        <activity
            android:name=".tugas2.activity.Tugas2FirstActivity"
            android:exported="true"
            android:label="Tugas 2 - Dua Activity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".tugas2.activity.Tugas2SecondActivity"
            android:exported="false"
            android:label="Tugas 2 - Activity 2" />

        <!-- Latihan 2 : Compose Navigation -->
        <activity
            android:name=".latihan2.activity.Latihan2Activity"
            android:exported="true"
            android:label="Latihan 2 - Navigation">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tugas 3 : LazyColumn + stickyHeader -->
        <activity
            android:name=".tugas3.activity.Tugas3Activity"
            android:exported="true"
            android:label="Tugas 3 - Katalog Buah">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>